# Application
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production

# Database
DATABASE_URL=mysql+aiomysql://root:root@localhost/NesaCare
DATABASE_URL_SYNC=mysql+pymysql://root:root@localhost/NesaCare

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# OpenAI (chatbot + appointment assistant)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Twilio (voice reminders + SMS/WhatsApp)
OPENAI_API_KEY=your_openai_api_key
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Test phone (trial: verify in Twilio Console). Alias: TWILIO_TO_NUMBER
TWILIO_TO_NUMBER=

# Public URL for Twilio webhooks (ngrok in local dev)
PUBLIC_BASE_URL=http://localhost:8000

# Hospital info (FAQ / chatbot)
HOSPITAL_NAME=NesaCare Hospital
HOSPITAL_HOURS=Mon-Sat 8:00 AM - 8:00 PM
HOSPITAL_LOCATION=123 Healthcare Avenue
HOSPITAL_CONTACT=+1-800-NESACARE

# Voice reminder scheduling
VOICE_REMINDER_HOURS_BEFORE=24
CHAT_RATE_LIMIT_PER_MINUTE=30
