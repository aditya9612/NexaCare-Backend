# Nexa-Care HMS Configuration Example

APP_NAME="NexaCare HMS"
APP_ENV="development"
DEBUG=True
API_V1_PREFIX="/api/v1"

# Database Configuration (MySQL)
# Default assumes root user with root password on localhost. Change as needed.
DATABASE_URL: str = "mysql+aiomysql://nexauser:nexa123@localhost/nexacare"
DATABASE_URL_SYNC: str = "mysql+pymysql://nexauser:nexa123@localhost/nexacare"


# Security
# Set this to a long random secret key in production
SECRET_KEY="change-me-to-some-secure-random-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis Configuration (Required for Celery and caching)
REDIS_URL="redis://localhost:6379/0"

# Celery Configurations
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# Cache TTL Configurations
CHAT_SESSION_TTL_SECONDS=3600
ANALYTICS_CACHE_TTL_SECONDS=300

# File Upload Configurations
UPLOAD_DIR="app/uploads"
MAX_UPLOAD_SIZE_MB=10

# CORS Allowed Origins (Comma-separated list or JSON-like list)
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "https://nexacaresuperadmin.netlify.app", "https://nexacare360.netlify.app"]

# Authentication & OTP Settings
OTP_EXPIRE_MINUTES=10
STATIC_OTP_CODE="123456"

# Seed Data (Creates default Super Admin on startup)
SEED_SUPER_ADMIN=True
SEED_SUPER_ADMIN_EMAIL="admin@nesacare1234.com"
SEED_SUPER_ADMIN_PASSWORD="admin@1234"
SEED_SUPER_ADMIN_RESYNC_PASSWORD=False
ALLOW_ADMIN_SELF_REGISTER=True

# Third-party Integrations (Optional/Placeholder APIs)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@nesacare.com"

SMS_API_KEY=""
WHATSAPP_API_KEY=""
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
TWILIO_WHATSAPP_NUMBER=""

# Application
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production

# Database
DATABASE_URL: str = "mysql+aiomysql://nexauser:nexa123@localhost/nexacare"
DATABASE_URL_SYNC: str = "mysql+pymysql://nexauser:nexa123@localhost/nexacare"

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# OpenAI (chatbot + appointment assistant)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Twilio (voice reminders + SMS/WhatsApp)
OPENAI_API_KEY=your_openai_api_key
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Test phone (trial: verify in Twilio Console). Alias: TWILIO_TO_NUMBER
TWILIO_TO_NUMBER=

# Public URL for Twilio webhooks (ngrok in local dev)
PUBLIC_BASE_URL=http://localhost:8000

# Hospital info (FAQ / chatbot)
HOSPITAL_NAME=NesaCare Hospital
HOSPITAL_HOURS=Mon-Sat 8:00 AM - 8:00 PM
HOSPITAL_LOCATION=123 Healthcare Avenue
HOSPITAL_CONTACT=+1-800-NESACARE

# Voice reminder scheduling
VOICE_REMINDER_HOURS_BEFORE=24
CHAT_RATE_LIMIT_PER_MINUTE=30
