# Nexa-Care HMS Configuration Example

APP_NAME="NexaCare HMS"
APP_ENV="development"
DEBUG=True
API_V1_PREFIX="/api/v1"

# Database Configuration (MySQL)
# Default assumes root user with root password on localhost. Change as needed.
DATABASE_URL="mysql+aiomysql://root:root@localhost/NesaCare"
DATABASE_URL_SYNC="mysql+pymysql://root:root@localhost/NesaCare"

# Security
# Set this to a long random secret key in production
SECRET_KEY="change-me-to-some-secure-random-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis Configuration (Required for Celery and caching)
REDIS_URL="redis://localhost:6379/0"

# Celery Configurations
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# Cache TTL Configurations
CHAT_SESSION_TTL_SECONDS=3600
ANALYTICS_CACHE_TTL_SECONDS=300

# File Upload Configurations
UPLOAD_DIR="app/uploads"
MAX_UPLOAD_SIZE_MB=10

# CORS Allowed Origins (Comma-separated list or JSON-like list)
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# Authentication & OTP Settings
OTP_EXPIRE_MINUTES=10
STATIC_OTP_CODE="123456"

# Seed Data (Creates default Super Admin on startup)
SEED_SUPER_ADMIN=True
SEED_SUPER_ADMIN_EMAIL="admin@nesacare1234.com"
SEED_SUPER_ADMIN_PASSWORD="admin@1234"
SEED_SUPER_ADMIN_RESYNC_PASSWORD=False
ALLOW_ADMIN_SELF_REGISTER=True

# Third-party Integrations (Optional/Placeholder APIs)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@nesacare.com"

SMS_API_KEY=""
WHATSAPP_API_KEY=""
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
TWILIO_WHATSAPP_NUMBER=""
