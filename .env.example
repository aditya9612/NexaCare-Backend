# Nexa-Care HMS Configuration Example

APP_NAME="NexaCare HMS"
APP_ENV="development"
DEBUG=True
API_V1_PREFIX="/api/v1"

# Database Configuration (MySQL)
DATABASE_URL=mysql+aiomysql://nexauser:nexa123@localhost/nexacare
DATABASE_URL_SYNC=mysql+pymysql://nexauser:nexa123@localhost/nexacare



# Security
# Set this to a long random secret key in production
SECRET_KEY="change-me-to-some-secure-random-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis Configuration (Required for Celery and caching)
REDIS_URL="redis://localhost:6379/0"

# Celery Configurations
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# Cache TTL Configurations
CHAT_SESSION_TTL_SECONDS=3600
ANALYTICS_CACHE_TTL_SECONDS=300

# File Upload Configurations
UPLOAD_DIR="app/uploads"
MAX_UPLOAD_SIZE_MB=10

# CORS Allowed Origins (Comma-separated list or JSON-like list)
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "https://nexacaresuperadmin.netlify.app", "https://nexacare360.netlify.app"]

# Authentication & OTP Settings
OTP_EXPIRE_MINUTES=10
STATIC_OTP_CODE="123456"

# Seed Data (Creates default Super Admin on startup)
SEED_SUPER_ADMIN=True
SEED_SUPER_ADMIN_EMAIL="admin@nesacare1234.com"
SEED_SUPER_ADMIN_PASSWORD="admin@1234"
SEED_SUPER_ADMIN_RESYNC_PASSWORD=False
ALLOW_ADMIN_SELF_REGISTER=True

# Third-party Integrations (Optional/Placeholder APIs)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@nesacare.com"

SMS_API_KEY=""
WHATSAPP_API_KEY=""
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
TWILIO_WHATSAPP_NUMBER=""

# Application
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production

# Database
DATABASE_URL=mysql+aiomysql://nexauser:nexa123@localhost/nexacare
DATABASE_URL_SYNC=mysql+pymysql://nexauser:nexa123@localhost/nexacare

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# OpenAI (chatbot + appointment assistant)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Twilio (voice reminders + SMS/WhatsApp)
OPENAI_API_KEY=your_openai_api_key
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Test phone (trial: verify in Twilio Console). Alias: TWILIO_TO_NUMBER
TWILIO_TO_NUMBER=

# Public URL for Twilio webhooks (ngrok in local dev)
PUBLIC_BASE_URL=https://tried-shaft-fanning.ngrok-free.dev

# Hospital info (FAQ / chatbot)
HOSPITAL_NAME=NesaCare Hospital
HOSPITAL_HOURS=Mon-Sat 8:00 AM - 8:00 PM
HOSPITAL_LOCATION=123 Healthcare Avenue
HOSPITAL_CONTACT=+1-800-NESACARE

# Voice reminder scheduling
VOICE_REMINDER_HOURS_BEFORE=24
CHAT_RATE_LIMIT_PER_MINUTE=30

# ICU telemetry
ICU_TELEMETRY_ECG_MAX_SAMPLES=1000

# ICU telemetry
ICU_TELEMETRY_ECG_MAX_SAMPLES=1000

GROQ_API_KEY=""

# Google Gemini (voice agent LLM)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Sarvam AI voice cloning (TTS for greeting + booking prompts)
# 1) Create API key + clone voice in Sarvam Creator Studio
# 2) Set VOICE_CLONE_ENABLED=true
# 3) Prefer SARVAM_VOICE_ID (Studio synthesize voice_id UUID for clones)
# 4) Optional SARVAM_SPEAKER for built-in voices (ratan, shubh, ...) on public API
# 5) If Studio returns 401, paste browser Cookie into SARVAM_STUDIO_COOKIE
VOICE_CLONE_ENABLED=false
SARVAM_API_KEY=
SARVAM_VOICE_ID=
SARVAM_SPEAKER=
SARVAM_STUDIO_COOKIE=
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_CODEC=mp3
SARVAM_TTS_SAMPLE_RATE=16000
SARVAM_TTS_PACE=1.0
SARVAM_TTS_TIMEOUT_SECONDS=30.0
SARVAM_TTS_CACHE_DIR=app/uploads/voice-cache
SARVAM_CLONE_MAX_CHARS=1000

NGROK_AUTH_TOKEN=""
# Telephony: India-first default can be exotel; twilio remains for backward compatibility
DEFAULT_TELEPHONY_PROVIDER=twilio
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_PHONE_NUMBER=
EXOTEL_WEBHOOK_SECRET=
# Set true only for local/dev webhook testing without signatures
SKIP_VOICE_WEBHOOK_AUTH=false
VOICE_CONFIG_CACHE_TTL_SECONDS=600
VOICE_FAQ_CACHE_TTL_SECONDS=600
VOICE_AI_CONFIDENCE_THRESHOLD=0.65
MEDICATION_REMINDER_MINUTES=15
