# Environment-based settings for Production
ENVIRONMENT="production"
ENABLE_EMAIL_OTP=True
PIN_MAX_ATTEMPTS=5
PIN_LOCKOUT_MINUTES=15

# SMTP Email Configuration (Required when ENABLE_EMAIL_OTP is True)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME="your-smtp-account@gmail.com"
SMTP_PASSWORD="your-google-app-password"
SMTP_FROM_EMAIL="your-smtp-account@gmail.com"

